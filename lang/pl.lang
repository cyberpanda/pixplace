# ---- Website ----
web.tagline = Czat 2D z własnymi avatarami i pokojami
web.enter = Do czatu
web.nav.features = Funkcje
web.nav.howto = Pierwsze kroki
web.nav.safety = Bezpieczeństwo
web.nav.legal = Informacje prawne
web.hero.text = Czat, który wygląda jak miejsce. Poruszasz się jako obraz po pokojach, mówisz w dymkach i wszystko urządzasz sam – w przeglądarce, bez instalacji.
web.f.avatars.h = Własne avatary
web.f.avatars.p = Wgraj obrazy, wytnij tło i noś do dwunastu naraz. Wszystko trafia do torby i tam zostaje.
web.f.rooms.h = Pokoje i drzwi
web.f.rooms.p = Własne pokoje z własnym tłem, połączone drzwiami. Jeśli chcesz, zamkniesz pokój jednym kliknięciem.
web.f.guilds.h = Gildie i klany
web.f.guilds.p = Załóż grupę, ustal własne rangi i prawa, zbieraj renomę i odblokowuj korzyści.
web.f.media.h = Wspólne oglądanie
web.f.media.p = Udostępnij film w pokoju – gra u wszystkich naraz. Chcesz tylko słuchać? Przełącz na dźwięk.
web.f.whisper.h = Szepty i czat grupy
web.f.whisper.p = Prywatne wiadomości także między pokojami oraz kanał, który czytają tylko członkowie.
web.f.script.h = Programuj pokoje
web.f.script.p = Z PPScript pokoje reagują na zdarzenia: witają, liczą, przekierowują. Jedna linia, jedno polecenie.
web.howto.h = Trzy kroki, by dołączyć
web.howto.1 = Dotknij „Do czatu”. Jako gość od razu dostajesz nazwę – nic więcej nie trzeba.
web.howto.2 = Wrzuć obraz do torby jako avatar i założ go.
web.howto.3 = Do własnych pokoi lub gildii zostań członkiem. Nazwa będzie wtedy zarezerwowana dla ciebie.
web.safety.h = Jak działa tu moderacja
web.safety.filter = Moderacja jest w większości automatyczna: filtry wychwytują zakazane słowa, zalewanie wiadomościami i podejrzane treści. Użycie metod automatycznych, w tym SI, jest możliwe, ale obecnie nie ma miejsca.
web.safety.noread = Nikt po prostu nie czyta razem z tobą. Rozmowy nie są stale obserwowane. Do dzienników zaglądamy tylko z powodu – po zgłoszeniu lub przy konkretnym podejrzeniu.
web.safety.logged = Aby to było możliwe, pokoje są rejestrowane. Napis „moderowane i rejestrowane” jest stale widoczny w oknie czatu.
web.safety.own = Udział odbywa się na własną odpowiedzialność. Treści pochodzą od użytkowników, nie od operatora.
web.safety.report = Zgłaszanie problemów: poleceniem ::page dotrzesz do moderacji wprost na czacie.
web.legal.imprint = Informacje prawne
web.legal.privacy = Prywatność
web.legal.terms = Warunki korzystania
web.status = Status
web.footer.note = Prywatnie prowadzony projekt hobbystyczny. Bez gwarancji dostępności.

